{
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false,
    "exclude": ["tests"]
  },
  "tasks": {
    "test": "deno test --allow-env",
    "lint": "deno lint",
    "check": "deno check pr-review-bot/index.ts pr-review-bot/review_local.ts",
    "review": "deno run --allow-run pr-review-bot/review_local.ts"
  }
}
