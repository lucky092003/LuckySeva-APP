# Copy to backend/.env and fill from your Supabase dashboard
# (Project Settings -> API -> Project URL / service_role / JWT secret)
SUPABASE_URL=your-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# --- Phone OTP ---
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Show the generated code in the app (no SMS provider yet).
OTP_DEBUG=true
# Accept any 6-digit code and skip OTP checks. Keep false to test the real flow.
OTP_BYPASS=false