# Copy to backend/.env and fill from your Supabase dashboard
# (Project Settings -> API -> Project URL / service_role / JWT secret)
SUPABASE_URL=your-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Phone OTP (POST /auth/request-otp -> POST /auth/verify-otp) -------------------
# How long a generated code stays valid.
OTP_TTL_SECONDS=300
# Minimum gap between two codes for the same phone number.
OTP_RESEND_COOLDOWN_SECONDS=30
# Wrong codes allowed before the code is thrown away.
OTP_MAX_ATTEMPTS=5
# DEV ONLY: return the generated code as `debug_code` so the app can show it on
# screen (there is no SMS provider yet). Turn OFF in production.
OTP_DEBUG=false
# DEV ONLY: accept any 6-digit code and skip OTP checks entirely. Turn OFF in production.
OTP_BYPASS=false