# REQUIRED. Base URL of the deployed FastAPI backend (no trailing slash).
# Every API call is made against this URL, so a wrong value breaks login and all data screens.
# Live backend: https://luckyseva-app-gbjw.onrender.com
VITE_API_URL=https://luckyseva-app-gbjw.onrender.com
# Which role THIS build serves. Each build (web or mobile) is locked to one role:
#   customer -> LuckySeva app (com.luckyseva.app), plus the customer website
#   provider -> LuckySeva Partner app (com.luckyseva.partner), plus the partner website
#   admin    -> admin dashboard website only (NO mobile app)
# Set this per Vercel project. Defaults to "customer" when unset.
VITE_APP_ROLE=customer
# Set to "true" to render the app inside a phone mockup on web (demo only).
# Leave unset in production so the site works like a normal website.
VITE_PHONE_MOCKUP=false
# The frontend does NOT talk to Supabase directly. The backend holds the
# Supabase service key, so VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are unused here.
