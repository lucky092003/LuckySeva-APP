VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
# Which role THIS build serves. Each build (web or mobile) is locked to one role:
#   customer -> LuckySeva app (com.luckyseva.app), plus the customer website
#   provider -> LuckySeva Partner app (com.luckyseva.partner), plus the partner website
#   admin    -> admin dashboard website only (NO mobile app)
# Defaults to "customer" when unset.
VITE_APP_ROLE=customer
# Set to "true" to render the app inside a phone mockup on web (demo only).
# Leave unset in production so the site works like a normal website.
VITE_PHONE_MOCKUP=false
